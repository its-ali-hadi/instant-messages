<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <title>نافذة المحادثة - <%= user.name %></title>
    <link rel="stylesheet" href="/css/style.css?v=1.2">
</head>
<body>
    <div class="chat-container">
        <header class="chat-header">
            <h2>From <%= user.username %> to ( <%= currentRecipient %> )</h2>
            <span class="current-user" style="display:none;"><%= user.username %></span>
            <div class="user-info">
                <a href="/chat" class="btn logout-btn">قائمة الاختيار</a>
                <a href="/logout" class="btn logout-btn">تسجيل الخروج</a>
                <button id="clearChat" class="btn clear-btn">مسح المحادثة</button>
            </div>
        </header>
        
        <div class="chat-messages" id="chatMessages">
            <% messages.forEach(function(message) { %>
                <% if (
        (message.sender === user.username && message.recipient === currentRecipient) ||
        (message.sender === currentRecipient && message.recipient === user.username)
     ) { %>

                    <div class="message <%= message.sender === user.username ? 'sent' : 'received' %>" data-id="<%= message.id %>">
                        <div class="message-content <%= message.read ? 'read' : 'unread' %>">
                            <% if (message.file) { %>
                                <div class="file-message">
                                    <% if (message.file.mimetype.startsWith('image/')) { %>
                                        <img src="/download/<%= message.file.filename %>" alt="صورة مرسلة" class="file-preview" id="img">
                                    <% } else { %>
                                        <div class="file-icon"><%= message.file.originalname %></div>
                                    <% } %>
                                    <a href="/download/<%= message.file.filename %>" download="<%= message.file.originalname %>" class="download-btn">تنزيل</a>
                                </div>
                            <% } %>

                            <% if (message.text) { %>
                                <p><%= message.text %></p>
                            <% } %>

                            <div class="message-meta">
                                <span class="timestamp"><%= new Date(message.timestamp).toLocaleString('ar-EG') %></span>
                                <% if (message.sender === user.username) { %>
                                    <span class="read-status">
                                        <% if (message.read) { %>
                                            ✓ <%= new Date(message.readTimestamp).toLocaleString('ar-EG') %>
                                        <% } else { %>
                                            ✓
                                        <% } %>
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            <% }); %>
        </div>

        <div class="typing-indicator" id="typingIndicator" style="display: none;">
            <span id="typingText"></span>
        </div>

        <!-- اختيار المستلم -->
        <form class="message-form" id="messageForm" enctype="multipart/form-data">
            <div class="form-group" style="display: none;">
                <label for="recipient">اختر المستلم:</label>
                <select name="recipient" id="recipient" required>
                <% user.allowed.forEach(function(r) { %>
                    <option value="<%= r %>" <%= currentRecipient === r ? 'selected' : '' %>><%= r %></option>
                <% }); %>
                </select>

            </div>

            <div class="input-group">
                <input type="text" name="text" id="messageInput" placeholder="اكتب رسالتك هنا..." autocomplete="off">
                <input type="file" name="file" id="fileInput" accept="image/*,.pdf,.doc,.docx" style="display: none;">
                <label for="fileInput" class="file-label">📎</label>
                <button type="submit" class="send-btn">إرسال</button>
            </div>
            <div class="cooldown-indicator" id="cooldownIndicator" style="display:none;">
                يرجى الانتظار <span id="cooldownSeconds">1</span> ثانية قبل إرسال رسالة جديدة
            </div>
            <div id="filePreview" class="file-preview-container"></div>
        </form>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/script.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
document.addEventListener('click', function (e) {
    if (e.target.classList.contains('file-preview')) {
        const overlay = document.createElement('div');
        overlay.id = 'imageOverlay';
        overlay.style.cssText = `
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10000;
        `;
        const enlargedImg = document.createElement('img');
        enlargedImg.src = e.target.src;
        enlargedImg.style.cssText = `
            max-width: 90%;
            max-height: 90%;
        `;
        overlay.appendChild(enlargedImg);
        document.body.appendChild(overlay);

        overlay.addEventListener('click', function () {
            document.body.removeChild(overlay);
        });
    }
});
    });
</script>
</body>
</html>